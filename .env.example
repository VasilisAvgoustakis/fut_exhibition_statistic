# Database configuration
DB_HOST=mysql-db
DB_USER=regular_user
DB_PORT=3306
DB_PASSWORD=regular_pass
DB_DATABASE=futurium_exhibition_stats

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# MQTT configuration
MQTT_BROKER_ADDRESS=172.25.12.123
MQTT_TOPIC=tokenStations/+/onScan

# Time configuration
SUB_START_TIME=15:14:00
REGULAR_STOP_TIME=17:00:00
THURSDAY_STOP_TIME=20:00:00
CLOSED_DAY_STOP_TIME=09:00:00

# File paths
DAILY_SCANS_FILE=./network_traffic_archives/token_daily_log.txt
SCANS_ARCHIVE_FILE=./network_traffic_archives/token_archive_log.txt
DAILY_ASSET_LOG=./network_traffic_archives/access.log

# Date ranges for statistics
STATS_START_DATE=2020-09-23
# STATS_END_DATE is set to yesterday by default

# Logging configuration
LOGGING_LEVEL=INFO
LOGGING_FORMAT=%(asctime)s [%(levelname)s] %(message)s
LOGGING_FILEMODE=a

# Flask configuration
FLASK_PORT=8050
FLASK_ENV=development
FLASK_DEBUG=1